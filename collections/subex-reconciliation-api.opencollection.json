{
  "opencollection": "1.0.0",
  "info": {
    "name": "Subex Revenue Assurance & Fraud Management Analytics Reconciliation API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reconciliation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List reconciliation runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.subex.example.com/roc/v1/reconciliation/runs",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "runType",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns reconciliation run history for CDR and billing data matching."
        }
      ]
    }
  ],
  "bundled": true
}